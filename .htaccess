# إعدادات الخادم للموقع الثابت (هوستنجر / LiteSpeed أو Apache)
# ملاحظة: مجلد ووردبريس (cms/) له ملف .htaccess خاص به ولا يتأثر بقواعد التحويل هنا.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# إجبار HTTPS
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://iraqbuilders.org%{REQUEST_URI} [L,R=301]
# بدون www
RewriteCond %{HTTP_HOST} ^www\.iraqbuilders\.org$ [NC]
RewriteRule ^ https://iraqbuilders.org%{REQUEST_URI} [L,R=301]
</IfModule>

# تحويل روابط الموقع القديم إلى الجديد (يحافظ على ظهور الموقع في جوجل)
<IfModule mod_alias.c>
RedirectMatch 301 ^/about/?$ /about.html
RedirectMatch 301 ^/contact-us/?$ /contact.html
RedirectMatch 301 ^/volunteer/?$ /volunteer.html
RedirectMatch 301 ^/الاخبار/?$ /news.html
RedirectMatch 301 ^/مشروع-خطوة/?$ /activities.html
RedirectMatch 301 ^/انشطة-رمضان/?$ /activities.html
RedirectMatch 301 ^/المتجر/?$ /
</IfModule>

# ترويسات أمان
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
# فعّل السطر التالي بعد التأكد أن HTTPS يعمل على كل الصفحات:
# Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# منع الوصول للملفات المخفية وملفات التوثيق
<FilesMatch "^\.(?!well-known)|\.(md|log)$">
Require all denied
</FilesMatch>

# ضغط وتخزين مؤقت
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType text/css "access plus 1 day"
ExpiresByType application/javascript "access plus 1 day"
ExpiresByType text/html "access plus 5 minutes"
</IfModule>
