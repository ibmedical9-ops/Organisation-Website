# إعدادات الخادم للموقع الثابت (هوستنجر / LiteSpeed أو Apache)
#
# مهم: يوجد على نفس الاستضافة موقع آخر (النظام الطبي في مجلد system، ونطاقه system.iraqbuilders.org).
# لذلك كل القواعد هنا محصورة بنطاق iraqbuilders.org فقط، ولا تغيّر سلوك النظام الطبي.
# مجلد ووردبريس (cms/) له ملف .htaccess خاص به.

Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# إجبار HTTPS (لا يغيّر النطاق)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# النظام الطبي له نطاقه الفرعي؛ لا يُفتح عبر مسار /system على النطاق الرئيسي
RewriteCond %{HTTP_HOST} ^(www\.)?iraqbuilders\.org$ [NC]
RewriteRule ^system(/.*)?$ https://system.iraqbuilders.org$1 [L,R=301]

# www إلى بدون www
RewriteCond %{HTTP_HOST} ^www\.iraqbuilders\.org$ [NC]
RewriteRule ^ https://iraqbuilders.org%{REQUEST_URI} [L,R=301]

# تحويل روابط الموقع القديم إلى الجديد (يحافظ على ظهور الموقع في جوجل)، للنطاق الرئيسي فقط
RewriteCond %{HTTP_HOST} ^iraqbuilders\.org$ [NC]
RewriteRule ^about/?$ /about.html [L,R=301]
RewriteCond %{HTTP_HOST} ^iraqbuilders\.org$ [NC]
RewriteRule ^contact-us/?$ /contact.html [L,R=301]
RewriteCond %{HTTP_HOST} ^iraqbuilders\.org$ [NC]
RewriteRule ^volunteer/?$ /volunteer.html [L,R=301]
RewriteCond %{HTTP_HOST} ^iraqbuilders\.org$ [NC]
RewriteRule ^الاخبار/?$ /news.html [L,R=301]
RewriteCond %{HTTP_HOST} ^iraqbuilders\.org$ [NC]
RewriteRule ^مشروع-خطوة/?$ /activities.html [L,R=301]
RewriteCond %{HTTP_HOST} ^iraqbuilders\.org$ [NC]
RewriteRule ^انشطة-رمضان/?$ /activities.html [L,R=301]
RewriteCond %{HTTP_HOST} ^iraqbuilders\.org$ [NC]
RewriteRule ^المتجر/?$ / [L,R=301]
</IfModule>

# ترويسات أمان (للنطاق الرئيسي فقط حتى لا تتأثر النظام الطبي)
<IfModule mod_setenvif.c>
SetEnvIfNoCase Host ^(www\.)?iraqbuilders\.org$ IB_MAIN
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN" env=IB_MAIN
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()" env=IB_MAIN
Header always unset X-Powered-By
# سياسة محتوى بوضع المراقبة فقط (لا تحجب شيئًا). راقب Console في المتصفح، ثم غيّر الاسم إلى Content-Security-Policy.
Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://system.iraqbuilders.org; frame-src https://www.facebook.com; object-src 'none'; base-uri 'self'; form-action 'self'" env=IB_MAIN
# فعّل السطر التالي بعد التأكد أن HTTPS يعمل على كل الصفحات والنطاقات الفرعية:
# Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# منع الوصول للملفات المخفية وملفات التوثيق
<FilesMatch "^\.(?!well-known)|\.(md|log)$|^(readme\.html|license\.txt|error_log)$">
Require all denied
</FilesMatch>

# ضغط وتخزين مؤقت للملفات الثابتة فقط (لا نمسّ صفحات HTML حتى لا نؤثر على النظام الطبي)
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/css application/javascript image/svg+xml
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType text/css "access plus 1 day"
ExpiresByType application/javascript "access plus 1 day"
</IfModule>
